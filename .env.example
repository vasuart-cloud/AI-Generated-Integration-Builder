# GEMINI_API_KEY: Required for Company Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional override for administrator-configured Gemini model ID in the server Model Registry
COMPANY_GEMINI_MODEL="gemini-3.8-flash"

# Optional enterprise model provider credentials (disabled in UI with "Contact admin to configure" when unset)
OPENAI_API_KEY=""
COMPANY_OPENAI_MODEL="gpt-4.1"
ANTHROPIC_API_KEY=""
COMPANY_CLAUDE_MODEL="claude-sonnet-4-20250514"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
